{
  "name": "kuoluosaigai",
  "version": "0.4.0",
  "private": true,
  "workspaces": ["server", "packages/*"],
  "scripts": {
    "dev": "vue-cli-service serve",
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "start": "node server/start.js",
    "lint": "vue-cli-service lint src tests packages",
    "test": "vitest run && npm run test --workspace kuoluosaigai-server",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ant-design-vue": "^4.2.6",
    "core-js": "^3.8.3",
    "vue": "^3.2.13"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.9"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "globals": {
      "globalThis": "readonly"
    },
    "ignorePatterns": ["server/"],
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
